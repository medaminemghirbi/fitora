# Kamal reads secrets from here at deploy time. This file is git-ignored —
# never commit real values. Populate from your shell env or a secrets
# manager (see the Kamal docs for 1Password / Bitwarden helpers).

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$(cat config/master.key)
BACKEND_DATABASE_PASSWORD=$BACKEND_DATABASE_PASSWORD
POSTGRES_PASSWORD=$BACKEND_DATABASE_PASSWORD

# The accessory's own password must be the one the app connects with.
POSTGRES_PASSWORD=$BACKEND_DATABASE_PASSWORD

# Outgoing mail — required at boot (config/initializers/required_env.rb).
SMTP_USERNAME=
SMTP_PASSWORD=

# Recommended: without them errors go unreported and /sidekiq is not mounted.
SENTRY_DSN=
SIDEKIQ_WEB_PASSWORD=
# Optional: the web UI's browser errors, to a JavaScript project in Sentry.
# Uncomment here and in config/deploy.yml's secret list to turn it on.
# SENTRY_BROWSER_DSN=

# Nightly database backup (accessories.backup). PASSPHRASE encrypts each dump;
# keep a copy of it somewhere that is not this server.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
PASSPHRASE=
