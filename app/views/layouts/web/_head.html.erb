<meta charset="utf-8">
<title>Fitora</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#4a2a8f">
<%# Fitora's mark, as the landing page and the sign-in draw it: the .ico
    for browsers that want one, the SVG for the rest, a full-bleed PNG for
    a phone's home screen (public/). %>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;1,9..144,400;1,9..144,500&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<%# No page snapshots: Back shows the page as it is now, as the Angular app
    re-renders it, never a stale copy with yesterday's rows or an open menu. %>
<meta name="turbo-cache-control" content="no-cache">
<%= csrf_meta_tags %>
<%# Who the live notifications are for (lib/live_notifications.js): an
    admin, a superadmin or a member — NotificationService#connect's three. %>
<% if (live = live_notifications_for) %>
  <meta name="fitora-live" content="<%= live %>">
<% end %>
<%# Where browser errors go (lib/error_reporting.js): none without SENTRY_BROWSER_DSN. %>
<% if (sentry_dsn = Rails.configuration.x.sentry_browser_dsn) %>
  <meta name="sentry-dsn" content="<%= sentry_dsn %>">
  <meta name="sentry-environment" content="<%= Rails.env %>">
<% end %>
<%= stylesheet_link_tag "application", "ng-components", "data-turbo-track": "reload" %>
<%= javascript_include_tag "application", type: "module", "data-turbo-track": "reload" %>
