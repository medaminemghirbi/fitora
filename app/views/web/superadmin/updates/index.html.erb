<%# The release notes (Web::DataTable): every one with its version, title,
    author, screenshots and recordings counted, when it went out — searched,
    sorted, paged; a row opens the release. Publishing one is the drawer
    (superadmin-updates), which comes back here with the new release first. %>
<% url = "/superadmin/updates" %>
<% superadmin_crumbs [ ngt("superadmin.updates.title") ] %>
<div data-controller="superadmin-updates" data-superadmin-updates-url-value="<%= url %>"
     data-superadmin-updates-labels-value="<%= { too_many: Web::Translations.translate("superadmin.updates.too_many_files", {}, locale: I18n.locale), invalid: Web::Translations.translate("superadmin.updates.invalid_file", {}, locale: I18n.locale), error: ngt("common.error_generic") }.to_json %>"
     data-action="modal:opened@window->superadmin-updates#opened">
  <%= render layout: "web/superadmin/shared/page_head", locals: { title: ngt("superadmin.updates.title"), desc: ngt("superadmin.updates.subtitle") } do %>
    <button type="button" class="btn btn-primary" data-action="superadmin-updates#openCreate">
      <i class="bi bi-megaphone"></i> <%= ngt("superadmin.updates.new") %>
    </button>
  <% end %>

  <%= render layout: "web/superadmin/shared/table", locals: { table: @table, url: url, placeholder: ngt("superadmin.console.updates_search") } do %>
    <% if @updates.empty? %>
      <%= render "web/superadmin/shared/table_empty", table: @table, url: url, title: ngt("superadmin.updates.empty_title"), body: ngt("superadmin.updates.empty_body"), icon: "bi-megaphone" %>
    <% else %>
      <div class="sa-scroll">
        <table class="table sa-grid">
          <thead>
            <tr>
              <%= superadmin_sort_th @table, :version, ngt("superadmin.updates.version_label"), url %>
              <%= superadmin_sort_th @table, :title, ngt("superadmin.updates.title_label"), url %>
              <th scope="col"><%= ngt("superadmin.console.author") %></th>
              <th scope="col"><%= ngt("superadmin.console.media") %></th>
              <%= superadmin_sort_th @table, :published, ngt("superadmin.console.published"), url, css: "sa-nowrap" %>
              <th class="sa-col-go" aria-hidden="true"></th>
            </tr>
          </thead>
          <tbody>
            <% @updates.each do |update| %>
              <% href = "/superadmin/updates/#{update.id}" %>
              <tr class="sa-row" data-action="click->data-table#open" data-href="<%= href %>">
                <td class="sa-nowrap"><span class="sa-chip sa-chip--primary" dir="ltr">v<%= ng_highlight(update.version, @table.term) %></span></td>
                <td>
                  <a class="sa-lead-title" href="<%= href %>" data-turbo-frame="_top"><%= ng_highlight(update.title, @table.term) %></a>
                  <% if update.description.present? %><div class="sa-sub sa-clip"><%= update.description %></div><% end %>
                </td>
                <td class="sa-sub"><%= update.created_by.full_name %></td>
                <td class="sa-sub">
                  <% if update.media.any? %><i class="bi bi-images"></i> <%= update.media.size %><% else %>—<% end %>
                </td>
                <td class="sa-nowrap sa-sub"><%= ng_date(update.published_at, "dd/MM/yyyy HH:mm") %></td>
                <td class="sa-col-go"><i class="bi bi-chevron-right sa-go"></i></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <%= render "web/superadmin/shared/table_foot", pagy: @pagy, table: @table, url: url %>
    <% end %>
  <% end %>
</div>

<%= render "web/superadmin/updates/create_drawer" %>
