<%# The gyms (Web::DataTable): every salle on Fitora with its admin and how to
    reach them, where it is, where the account stands and suspending its access
    — searched by name, city or admin, filtered on where it stands, sorted, paged.
    A row opens the gym. Opening a new account is the page's own action. %>
<% url = "/superadmin/companies" %>
<% superadmin_crumbs [ ngt("superadmin.companies") ] %>
<%= render layout: "web/superadmin/shared/page_head", locals: { title: ngt("superadmin.companies_title"), desc: ngt("superadmin.console.companies_desc") } do %>
  <a href="/superadmin/companies/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> <%= ngt("superadmin.create.cta") %></a>
<% end %>

<% filters = [
     { name: "activation", label: ngt("superadmin.console.filter_activation"), default: "",
       options: [ [ "", ngt("superadmin.console.any_activation") ], [ "pending", ngt("superadmin.console.activation_pending") ], [ "active", ngt("superadmin.activation.active") ], [ "suspended", ngt("superadmin.activation.suspended") ] ] }
   ] %>
<%= render layout: "web/superadmin/shared/table", locals: { table: @table, url: url, placeholder: ngt("superadmin.companies_search_placeholder"), filters: filters } do %>
  <% if @companies.empty? %>
    <%= render "web/superadmin/shared/table_empty", table: @table, url: url, title: ngt("superadmin.no_companies"), icon: "bi-buildings" %>
  <% else %>
    <div class="sa-scroll">
      <table class="table sa-grid">
        <thead>
          <tr>
            <%= superadmin_sort_th @table, :name, ngt("superadmin.console.gym"), url %>
            <%= superadmin_sort_th @table, :admin, ngt("superadmin.admin"), url %>
            <th scope="col"><%= ngt("superadmin.console.location") %></th>
            <th scope="col"><%= ngt("common.status") %></th>
            <%= superadmin_sort_th @table, :created, ngt("superadmin.console.created"), url, css: "sa-nowrap" %>
            <th scope="col"><%= ngt("superadmin.console.access") %></th>
            <th class="sa-col-go" aria-hidden="true"></th>
          </tr>
        </thead>
        <tbody>
          <% @companies.each do |company| %>
            <%= render "web/superadmin/companies/row", company: company, query: @table.term %>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "web/superadmin/shared/table_foot", pagy: @pagy, table: @table, url: url %>
  <% end %>
<% end %>
