<%# ng: superadmin-companies %>
<%# ng-host: superadmin-companies %>
<%# SuperadminCompaniesComponent: the gyms, searched (the search box keeps
    its focus), narrowed to the closed ones, paged — the list (_list)
    redrawn by superadmin-companies, the spinner meanwhile. %>
<div class="fx-page" data-controller="superadmin-companies" data-superadmin-companies-url-value="/superadmin/companies"
     data-superadmin-companies-query-value="<%= @query %>" data-superadmin-companies-closed-value="<%= @closed %>" data-superadmin-companies-page-value="<%= @meta[:page] %>">
  <header class="lst-head">
    <h1><%= ngt("superadmin.companies_title") %></h1>
    <span class="lst-head-count" data-superadmin-companies-target="count"><%= @companies.size %></span>
  </header>

  <div class="fx-toolbar">
    <div class="fx-input-icon">
      <i class="bi bi-search"></i>
      <input type="search" class="form-control form-control-sm" value="<%= @query %>" placeholder="<%= ngt("superadmin.companies_search_placeholder") %>" data-action="input->superadmin-companies#search" />
    </div>
    <%= render "web/superadmin/companies/closed_toggle", closed: @closed, closed_count: @closed_count %>
  </div>

  <%= render "web/superadmin/companies/list", list_locals %>
  <template data-superadmin-companies-target="spinner"><div class="d-flex justify-content-center py-5"><app-spinner><%= render "web/shared/spinner", size: 32 %></app-spinner></div></template>
  <template data-superadmin-companies-target="error"><div class="app-card"><div class="app-card-body"><app-error-state><%= render "web/shared/error_state", retry_action: "superadmin-companies#retry" %></app-error-state></div></div></template>
</div>
