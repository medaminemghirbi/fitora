<%# ng: superadmin-companies %>
<%# The gyms on this page: each with its admin, whether its door is open,
    its trial and what it owes, its account's plan and price, the search
    term marked; the pages under it. %>
<% if companies.empty? %>
  <div class="app-card"><div class="app-card-body">
    <app-empty-state><%= render layout: "web/shared/empty_state", locals: { title: ngt("superadmin.no_companies"), body: "", icon: "bi-buildings" } do %><% end %></app-empty-state>
  </div></div>
<% else %>
  <div class="app-card">
    <div class="fx-table-scroll">
      <table class="table align-middle companies-table">
        <thead>
          <tr>
            <th><%= ngt("superadmin.companies_title") %></th>
            <th><%= ngt("superadmin.admin") %></th>
            <th><%= ngt("common.status") %></th>
            <th><%= ngt("superadmin.plan_label") %></th>
            <th class="fx-num"><%= ngt("superadmin.total_month") %></th>
            <th aria-hidden="true"></th>
          </tr>
        </thead>
        <tbody>
          <% companies.each do |company| %>
            <% sub = company[:subscription] %>
            <tr class="companies-row" data-action="click->superadmin-companies#open" data-href="/superadmin/companies/<%= company[:id] %>">
              <td>
                <div class="company-cell">
                  <span class="company-ico"><i class="bi bi-building"></i></span>
                  <div>
                    <div class="fx-strong"><%= ng_highlight(company[:name], query) %></div>
                    <% if company[:city].present? %>
                      <div class="fx-muted" style="font-size: 0.8rem"><%= ng_highlight(company[:city], query) %></div>
                    <% end %>
                  </div>
                </div>
              </td>
              <td>
                <div><%= ng_highlight(company.dig(:admin, :full_name), query) %></div>
                <div class="fx-muted" style="font-size: 0.8rem"><%= ng_highlight(company.dig(:admin, :email), query) %></div>
              </td>
              <td>
                <div class="company-status">
                  <app-status-badge><%= render layout: "web/shared/status_badge", locals: { status: company[:access_open] ? "active" : "cancelled" } do %>
                    <%= ngt(company[:access_open] ? "superadmin.access_open" : "superadmin.access_closed") %>
                  <% end %></app-status-badge>
                  <% if sub&.dig(:trial) %>
                    <app-status-badge><%= render layout: "web/shared/status_badge", locals: { status: "trial" } do %>
                      <% if company[:access_open] && sub[:trial_days_left].to_i > 0 %>
                        <%= ngt("superadmin.on_trial", days: sub[:trial_days_left]) %>
                      <% else %>
                        <%= ngt("superadmin.trial_over") %>
                      <% end %>
                    <% end %></app-status-badge>
                  <% end %>
                  <% if company[:arrears_cents].to_i > 0 %>
                    <app-status-badge><%= render layout: "web/shared/status_badge", locals: { status: "unpaid" } do %>
                      <%= ng_money(company[:arrears_cents] / 100.0, company[:currency]) %>
                    <% end %></app-status-badge>
                  <% end %>
                </div>
              </td>
              <td>
                <% if company[:plan] %>
                  <span class="company-plan" data-plan="<%= company[:plan] %>"><%= ngt("subscription.plan_#{company[:plan]}") %></span>
                <% else %>
                  <span class="fx-muted">—</span>
                <% end %>
                <% if company.dig(:admin, :companies_count) > 1 %>
                  <div class="fx-muted" style="font-size: 0.8rem"><%= ngt("superadmin.account_salles", count: company.dig(:admin, :companies_count)) %></div>
                <% end %>
              </td>
              <td class="fx-num company-total">
                <%= ng_money(company[:monthly_subscription_cents] / 100.0, company[:currency]) %>
                <% if company.dig(:admin, :companies_count) > 1 %>
                  <div class="company-total-note"><%= ngt("superadmin.per_account") %></div>
                <% end %>
              </td>
              <td class="fx-num"><i class="bi bi-chevron-right fx-muted"></i></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <app-pagination><%= render "web/shared/pagination", meta: meta, action: "superadmin-companies#goToPage" %></app-pagination>
<% end %>
