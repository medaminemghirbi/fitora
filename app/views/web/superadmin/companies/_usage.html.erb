<%# How much the gym really uses Fitora. %>
<section class="app-card">
  <div class="app-card-header">
    <h2><%= ngt("superadmin.usage_title") %></h2>
  </div>
  <div class="sa-ministats">
    <div class="sa-ministat"><strong><%= c.dig(:usage, :clients) %></strong><span><%= ngt("nav.clients") %></span></div>
    <div class="sa-ministat"><strong><%= c.dig(:usage, :staff) %></strong><span><%= ngt("nav.team") %></span></div>
    <div class="sa-ministat"><strong><%= c.dig(:usage, :activities) %></strong><span><%= ngt("nav.activities") %></span></div>
    <div class="sa-ministat<%= " is-due" if c.dig(:usage, :sessions_last_30_days).zero? %>"><strong><%= c.dig(:usage, :sessions_last_30_days) %></strong><span><%= ngt("superadmin.usage_sessions_30") %></span></div>
  </div>
  <p class="sa-card-note">
    <i class="bi bi-clock-history"></i>
    <% if c.dig(:usage, :last_session_at) %>
      <%= ngt("superadmin.usage_last_session") %> <%= ng_date(c.dig(:usage, :last_session_at), "d MMM y") %>
    <% else %>
      <%= ngt("superadmin.usage_never") %>
    <% end %>
  </p>
</section>
