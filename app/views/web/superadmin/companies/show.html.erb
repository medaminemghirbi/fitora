<%# ng: superadmin-company-detail %>
<%# One gym's account, laid out as a record page: who it is and stepping inside
    it (the head); how far its activation has come, with the credentials to send
    again while the admin has not chosen a password; how much it is used; and
    beside them the gym itself: its account and salles, its currency and
    language. The host is written here for its controller (superadmin-company). %>
<% c = @data[:company]; admin = c[:admin] %>
<% salles = c[:account_companies] || [] %>
<% status, words = superadmin_activation(admin[:activation_state]) %>
<% superadmin_crumbs [ ngt("superadmin.companies"), "/superadmin/companies" ], [ c[:name] ] %>
<app-superadmin-company-detail data-controller="superadmin-company"
     data-superadmin-company-url-value="/superadmin/companies/<%= c[:id] %>"
     data-superadmin-company-labels-value="<%= { error: ngt("common.error_generic"), saving: ngt("common.saving"), resend_title: ngt("superadmin.credentials.resend_title"), resend_body: Web::Translations.translate("superadmin.credentials.resend_body", {}, locale: I18n.locale), resend_confirm: ngt("superadmin.credentials.resend") }.to_json %>"
     data-superadmin-company-email-value="<%= admin[:email] %>">
  <header class="sa-record-head">
    <span class="sa-record-ico"><i class="bi bi-building"></i></span>
    <div class="sa-record-titles">
      <h1 class="sa-page-title"><%= c[:name] %></h1>
      <div class="sa-record-meta">
        <app-status-badge><%= render layout: "web/shared/status_badge", locals: { status: status } do %><%= words %><% end %></app-status-badge>
        <span class="sa-record-fact"><i class="bi bi-person"></i> <%= admin[:full_name] %></span>
        <% if c[:city].present? %><span class="sa-record-fact"><i class="bi bi-geo-alt"></i> <%= c[:city] %></span><% end %>
        <span class="sa-record-fact"><i class="bi bi-calendar3"></i> <%= ngt("superadmin.created_on") %> <%= ng_date(c[:created_at], "dd/MM/yyyy") %></span>
      </div>
    </div>
    <div class="sa-page-actions">
      <a href="/superadmin/mailings/new?admin_id=<%= admin[:id] %>" class="btn btn-sm btn-ghost"><i class="bi bi-envelope" aria-hidden="true"></i> <%= ngt("superadmin.mailing.write_admin") %></a>
      <%= render "web/superadmin/companies/access_button", id: c[:id], name: c[:name], suspended: admin[:access_suspended_at].present? %>
      <button type="button" class="btn btn-primary" data-action="superadmin-company#impersonate">
        <i class="bi bi-box-arrow-in-right"></i>
        <%= ngt("superadmin.impersonate_named", name: admin[:full_name]) %>
      </button>
    </div>
  </header>

  <% if admin[:access_suspended_at] %>
    <div class="sa-notice sa-notice--danger" role="status"><i class="bi bi-slash-circle" aria-hidden="true"></i> <span><%= ngt("superadmin.access.notice", date: ng_date(admin[:access_suspended_at], "dd/MM/yyyy")) %></span></div>
  <% end %>

  <div class="sa-record">
    <div class="sa-record-main">
      <%= render "web/superadmin/companies/activation", admin: admin %>
      <%= render "web/superadmin/companies/usage", c: c %>
    </div>
    <aside class="sa-record-aside">
      <%= render "web/superadmin/companies/gym", c: c, salles: salles, currency_options: @data[:currency_options], locale_options: @data[:locale_options] %>
    </aside>
  </div>
</app-superadmin-company-detail>
