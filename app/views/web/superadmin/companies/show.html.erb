<%# ng: superadmin-company-detail %>
<%# One gym's account, laid out as a record page: who it is and stepping
    inside it (the head); what needs deciding, when anything does; the four
    figures that say whether it pays; then the money in the main column —
    the subscription and the next invoice, the ledger, the invoices — and
    the gym itself beside it: its account and salles, how much it is used,
    its currency and language, and its access. The host is written here for
    its controller (superadmin-company). %>
<% c = @data[:company]; invoices = @data[:invoices]; sub = c[:subscription] || {} %>
<% attention = superadmin_attention(c); arrears = (c[:arrears_cents] || 0) / 100.0 %>
<% salles = c[:account_companies] || [] %>
<% superadmin_crumbs [ ngt("superadmin.companies"), "/superadmin/companies" ], [ c[:name] ] %>
<app-superadmin-company-detail data-controller="superadmin-company"
     data-superadmin-company-url-value="/superadmin/companies/<%= c[:id] %>"
     data-superadmin-company-labels-value="<%= { error: ngt("common.error_generic"), void_title: ngt("superadmin.void_invoice_title"), void_body: Web::Translations.translate("superadmin.void_invoice_body", {}, locale: I18n.locale), saving: ngt("common.saving") }.to_json %>">
  <header class="sa-record-head">
    <span class="sa-record-ico"><i class="bi bi-building"></i></span>
    <div class="sa-record-titles">
      <h1 class="sa-page-title"><%= c[:name] %></h1>
      <div class="sa-record-meta">
        <app-status-badge><%= render layout: "web/shared/status_badge", locals: { status: sub[:active] ? "active" : "cancelled" } do %>
          <%= sub[:active] ? ngt("superadmin.access_open") : ngt("superadmin.access_closed") %>
        <% end %></app-status-badge>
        <% if c[:plan] %>
          <span class="sa-chip" data-plan="<%= c[:plan] %>"><%= c[:plan] == "pro" ? ngt("subscription.plan_pro") : ngt("subscription.plan_starter") %></span>
        <% end %>
        <% if sub[:trial] %>
          <app-status-badge><%= render layout: "web/shared/status_badge", locals: { status: "trial" } do %>
            <%= sub[:active] && sub[:trial_days_left].to_i > 0 ? ngt("superadmin.on_trial", days: sub[:trial_days_left]) : ngt("superadmin.trial_over") %>
          <% end %></app-status-badge>
        <% end %>
        <span class="sa-record-fact"><i class="bi bi-person"></i> <%= c.dig(:admin, :full_name) %></span>
        <% if c[:city].present? %><span class="sa-record-fact"><i class="bi bi-geo-alt"></i> <%= c[:city] %></span><% end %>
        <span class="sa-record-fact"><i class="bi bi-calendar3"></i> <%= ngt("superadmin.created_on") %> <%= ng_date(c[:created_at], "dd/MM/yyyy") %></span>
      </div>
    </div>
    <div class="sa-page-actions">
      <button type="button" class="btn btn-primary" data-action="superadmin-company#impersonate">
        <i class="bi bi-box-arrow-in-right"></i>
        <%= ngt("superadmin.impersonate_named", name: c.dig(:admin, :full_name)) %>
      </button>
    </div>
  </header>

  <% if attention %>
    <section class="ac-attention" data-kind="<%= attention %>">
      <div class="ac-attention-main">
        <% icon = { "due" => "bi-cash-coin", "never" => "bi-receipt" }.fetch(attention, "bi-lock-fill") %>
        <i class="bi <%= icon %>"></i>
        <div>
          <%# superadmin.attention_due / _never / _unpaid / _trial_over / _suspended %>
          <strong> <%= ngt("superadmin.attention_#{attention}", days: sub[:days_before_lock]) %> </strong>
          <span>
            <% if sub[:paid_through] %>
              <%= ngt("superadmin.attention_paid_through") %> <%= ng_date(sub[:paid_through], "d MMM y") %>
            <% else %>
              <%= ngt("superadmin.attention_never_paid") %>
            <% end %>
            <% if arrears > 0 %>
              · <%= ngt("superadmin.attention_arrears", amount: ng_money(arrears, c[:currency])) %>
            <% end %>
          </span>
        </div>
      </div>
      <% if attention == "suspended" %>
        <button type="button" class="btn btn-primary" data-action="superadmin-company#toggleAccess" data-superadmin-company-active-param="true">
          <%= ngt("superadmin.restore_access") %>
        </button>
      <% else %>
        <button type="button" class="btn btn-primary"<%= raw(" disabled") unless c[:plan] %> data-action="superadmin-company#issueInvoice"<%= raw(%( title="#{h(ngt("superadmin.choose_plan_first"))}")) unless c[:plan] %>>
          <%= ngt("superadmin.record_payment") %>
        </button>
      <% end %>
    </section>
  <% end %>

  <%= render "web/superadmin/companies/summary", c: c, sub: sub, arrears: arrears %>

  <div class="sa-record">
    <div class="sa-record-main">
      <%= render "web/superadmin/companies/billing", c: c, sub: sub, invoices: invoices %>
    </div>
    <aside class="sa-record-aside">
      <%= render "web/superadmin/companies/gym", c: c, sub: sub, salles: salles, currency_options: @data[:currency_options], locale_options: @data[:locale_options] %>
    </aside>
  </div>
</app-superadmin-company-detail>
