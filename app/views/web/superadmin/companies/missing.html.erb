<%# ng: superadmin-company-detail %>
<%# SuperadminCompanyDetailComponent when the gym cannot be read: the way
    back and the error state (its retry loads the page again). %>
<app-superadmin-company-detail data-controller="page-reload">
  <a href="/superadmin/companies" class="ac-back">
    <i class="bi bi-chevron-left"></i> <%= ngt("superadmin.companies") %>
  </a>
  <div class="app-card"><div class="app-card-body"><app-error-state><%= render "web/shared/error_state", retry_action: "page-reload#reload" %></app-error-state></div></div>
</app-superadmin-company-detail>
