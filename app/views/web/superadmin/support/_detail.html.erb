<%# ng: superadmin-support-tickets %>
<%# A ticket on its page: the gym, who wrote and how to reach them, when,
    the message, and its attachments (opened through this session, B-14).
    Resolving it is the page head's. %>
<div class="ticket-detail">
  <div class="ticket-detail-meta">
    <span><i class="bi bi-building"></i> <%= t.dig(:company, :name) %></span>
    <span><i class="bi bi-person"></i> <%= t.dig(:created_by, :full_name) %> · <%= t.dig(:created_by, :email) %></span>
    <span><i class="bi bi-clock"></i> <%= ng_date(t[:created_at], "dd/MM/yyyy HH:mm") %></span>
  </div>
  <p class="ticket-detail-message"><%= t[:message] %></p>

  <% if t[:attachments].any? %>
    <div class="ticket-attachments">
      <% t[:attachments].each do |att| %>
        <a href="/superadmin/support/<%= t[:id] %>/attachments/<%= att[:id] %>" target="_blank" rel="noopener" class="ticket-attachment">
          <i class="bi<%= support_file_icon(att[:content_type]) %>"></i>
          <%= att[:filename] %>
        </a>
      <% end %>
    </div>
  <% end %>

</div>
