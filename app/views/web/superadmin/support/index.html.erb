<%# Every gym's support tickets (Web::DataTable): the open ones unless asked
    otherwise, searched by subject, message, gym or author, filtered on what
    they are about, sorted, paged. Each row says who wrote and how to call
    them back; it opens the ticket. %>
<% url = "/superadmin/support" %>
<% superadmin_crumbs [ ngt("superadmin.support.title") ] %>
<%= render layout: "web/superadmin/shared/page_head", locals: { title: ngt("superadmin.support.title"), desc: ngt("superadmin.support.subtitle") } do %><% end %>

<% filters = [
     { name: "status", label: ngt("superadmin.support.status_col"), default: "open",
       options: [ [ "open", ngt("superadmin.support.filter_open") ], [ "resolved", ngt("modules_page.contact.status_resolved") ], [ "all", ngt("superadmin.support.filter_all") ] ] },
     { name: "kind", label: ngt("superadmin.console.filter_kind"), default: "",
       options: [ [ "", ngt("superadmin.console.any_kind") ], [ "general", ngt("superadmin.console.kind_general") ], [ "upgrade", ngt("superadmin.support.kind_upgrade") ] ] }
   ] %>
<%= render layout: "web/superadmin/shared/table", locals: { table: @table, url: url, placeholder: ngt("superadmin.console.support_search"), filters: filters } do %>
  <% if @tickets.empty? %>
    <%= render "web/superadmin/shared/table_empty", table: @table, url: url, title: ngt("superadmin.support.empty_title"), body: ngt("superadmin.support.empty_body"), icon: "bi-headset" %>
  <% else %>
    <div class="sa-scroll">
      <table class="table sa-grid">
        <thead>
          <tr>
            <%= superadmin_sort_th @table, :company, ngt("superadmin.support.company_col"), url %>
            <%= superadmin_sort_th @table, :subject, ngt("superadmin.support.subject_col"), url %>
            <th scope="col"><%= ngt("superadmin.support.attachments_col") %></th>
            <th scope="col"><%= ngt("superadmin.support.status_col") %></th>
            <%= superadmin_sort_th @table, :created, ngt("superadmin.support.date_col"), url, css: "sa-nowrap" %>
            <th class="sa-col-go" aria-hidden="true"></th>
          </tr>
        </thead>
        <tbody>
          <% @tickets.each do |ticket| %>
            <% href = "/superadmin/support/#{ticket.id}" %>
            <tr class="sa-row" data-action="click->data-table#open" data-href="<%= href %>">
              <td>
                <div class="sa-lead-title"><%= ng_highlight(ticket.company.name, @table.term) %></div>
                <div class="sa-sub"><%= ng_highlight(ticket.created_by.full_name, @table.term) %></div>
                <% if ticket.contact_phone.present? %>
                  <a class="sa-sub" href="<%= support_tel_href(ticket.contact_phone) %>" dir="ltr"><i class="bi bi-telephone"></i> <%= ticket.contact_phone %></a>
                <% end %>
              </td>
              <td>
                <% if ticket.upgrade? %>
                  <span class="sa-chip sa-chip--primary"><i class="bi bi-gem"></i> <%= ngt("superadmin.support.kind_upgrade") %></span>
                <% end %>
                <div><a class="sa-lead-title" href="<%= href %>" data-turbo-frame="_top"><%= ng_highlight(ticket.subject, @table.term) %></a></div>
                <div class="sa-sub sa-clip"><%= ticket.message %></div>
              </td>
              <td class="sa-sub">
                <% if ticket.attachments.any? %><i class="bi bi-paperclip"></i> <%= ticket.attachments.size %><% else %>—<% end %>
              </td>
              <td>
                <% if ticket.resolved? %>
                  <span class="sa-chip sa-chip--success"><%= ngt("modules_page.contact.status_resolved") %></span>
                <% else %>
                  <span class="sa-chip sa-chip--warning"><%= ngt("modules_page.contact.status_open") %></span>
                <% end %>
              </td>
              <td class="sa-nowrap sa-sub"><%= ng_date(ticket.created_at, "dd/MM/yyyy HH:mm") %></td>
              <td class="sa-col-go"><i class="bi bi-chevron-right sa-go"></i></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "web/superadmin/shared/table_foot", pagy: @pagy, table: @table, url: url %>
  <% end %>
<% end %>
