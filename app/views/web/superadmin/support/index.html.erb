<%# ng: superadmin-support-tickets %>
<%# ng-host: superadmin-support-tickets %>
<%# SuperadminSupportTicketsComponent: open tickets or all, each opening in
    a dialog (its content waits in a <template> per ticket) where it can be
    resolved (superadmin-support). %>
<div class="fx-page" data-controller="superadmin-support" data-superadmin-support-url-value="/superadmin/support"
     data-superadmin-support-filter-value="<%= @filter %>"
     data-superadmin-support-labels-value="<%= { resolved: ngt("superadmin.support.resolved"), error: ngt("common.error_generic") }.to_json %>"
     data-action="modal:opened@window->superadmin-support#fill">
  <header class="lst-head">
    <h1><%= ngt("superadmin.support.title") %></h1>
    <span class="lst-head-count" data-superadmin-support-target="count"><%= @tickets.size %></span>
    <div class="fx-segmented">
      <button type="button"<%= raw(' class="is-active"') if @filter == "open" %> data-action="superadmin-support#setFilter" data-superadmin-support-filter-param="open">
        <%= ngt("superadmin.support.filter_open") %>
      </button>
      <button type="button"<%= raw(' class="is-active"') if @filter == "all" %> data-action="superadmin-support#setFilter" data-superadmin-support-filter-param="all">
        <%= ngt("superadmin.support.filter_all") %>
      </button>
    </div>
  </header>

  <% if @tickets.empty? %>
    <div class="app-card">
      <div class="app-card-body">
        <app-empty-state><%= render layout: "web/shared/empty_state", locals: { title: ngt("superadmin.support.empty_title"), body: ngt("superadmin.support.empty_body"), icon: "bi-headset" } do %><% end %></app-empty-state>
      </div>
    </div>
  <% else %>
    <div class="app-card">
      <div class="fx-table-scroll">
        <table class="table align-middle">
          <thead>
            <tr>
              <th><%= ngt("superadmin.support.company_col") %></th>
              <th><%= ngt("superadmin.support.subject_col") %></th>
              <th><%= ngt("superadmin.support.attachments_col") %></th>
              <th><%= ngt("superadmin.support.status_col") %></th>
              <th><%= ngt("superadmin.support.date_col") %></th>
            </tr>
          </thead>
          <tbody>
            <% @tickets.each do |t| %>
              <%= render "web/superadmin/support/row", t: t %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>

  <% @tickets.each do |t| %>
    <template data-ticket="<%= t[:id] %>" data-subject="<%= t[:subject] %>"><%= render "web/superadmin/support/detail", t: t %></template>
  <% end %>
  <template data-superadmin-support-target="spinner"><div class="d-flex justify-content-center py-5"><app-spinner><%= render "web/shared/spinner", size: 32 %></app-spinner></div></template>
  <template data-superadmin-support-target="error"><div class="app-card"><div class="app-card-body"><app-error-state><%= render "web/shared/error_state", retry_action: "superadmin-support#retry" %></app-error-state></div></div></template>
</div>

<app-modal data-controller="modal" data-modal-name-value="support-ticket" data-action="support-ticket:open@window->modal#open">
  <template data-modal-target="template">
    <%= render layout: "web/shared/modal", locals: { title: "" } do %><% end %>
  </template>
</app-modal>
