<%# How Fitora is doing: four numbers with a decision behind each — gyms,
    new accounts, members, real use — then the newest gyms and what is waiting
    on a superadmin, each a click from its table. Opening an account is the
    page's one action. %>
<% m = @metrics; trend = superadmin_signup_trend(m[:companies]); share = superadmin_active_share(m) %>
<% waiting = m.dig(:companies, :awaiting_activation) %>
<% superadmin_crumbs [ ngt("superadmin.overview.nav") ] %>
<%= render layout: "web/superadmin/shared/page_head", locals: { title: ngt("superadmin.overview.nav"), desc: ngt("superadmin.console.overview_desc") } do %>
  <a href="/superadmin/companies/new" class="btn btn-primary"><i class="bi bi-plus-lg"></i> <%= ngt("superadmin.create.cta") %></a>
<% end %>

<section class="sa-kpis">
  <a class="fx-kpi" href="/superadmin/companies">
    <span class="fx-kpi-head"><span class="fx-kpi-icon"><i class="bi bi-buildings"></i></span> <%= ngt("superadmin.overview.gyms") %></span>
    <span class="fx-kpi-value"><%= m.dig(:companies, :total) %></span>
    <span class="sa-kpi-note">
      <% if waiting > 0 %>
        <span class="is-warn"><%= ngt("superadmin.overview.awaiting_count", count: waiting) %></span>
      <% else %>
        <%= ngt("superadmin.overview.all_active") %>
      <% end %>
    </span>
  </a>

  <a class="fx-kpi fx-kpi--success" href="/superadmin/companies">
    <span class="fx-kpi-head"><span class="fx-kpi-icon"><i class="bi bi-graph-up-arrow"></i></span> <%= ngt("superadmin.overview.new_this_month") %></span>
    <span class="fx-kpi-value"><%= m.dig(:companies, :new_this_month) %></span>
    <span class="sa-kpi-note">
      <% if trend.nil? %>
        <%= ngt("superadmin.overview.no_comparison") %>
      <% else %>
        <span class="fx-kpi-trend fx-kpi-trend--<%= trend.positive? ? "up" : (trend.negative? ? "down" : "flat") %>"><%= trend > 0 ? "+" : "" %><%= trend %>%</span>
        <%= ngt("superadmin.overview.vs_last_month", count: m.dig(:companies, :new_last_month)) %>
      <% end %>
    </span>
  </a>

  <div class="fx-kpi fx-kpi--info">
    <span class="fx-kpi-head"><span class="fx-kpi-icon"><i class="bi bi-people"></i></span> <%= ngt("superadmin.overview.members") %></span>
    <span class="fx-kpi-value"><%= m.dig(:members, :total) %></span>
    <span class="sa-kpi-note"><%= ngt("superadmin.overview.new_members", count: m.dig(:members, :new_this_month)) %></span>
  </div>

  <div class="fx-kpi">
    <span class="fx-kpi-head"><span class="fx-kpi-icon"><i class="bi bi-activity"></i></span> <%= ngt("superadmin.overview.in_use") %></span>
    <span class="fx-kpi-value"><%= share.nil? ? "—" : "#{share}%" %></span>
    <span class="sa-kpi-note"><%= ngt("superadmin.overview.in_use_note", count: m.dig(:activity, :companies_with_activity)) %></span>
  </div>
</section>

<div class="sa-split">
  <section class="app-card">
    <div class="app-card-header">
      <h2><%= ngt("superadmin.overview.newest") %></h2>
      <a href="/superadmin/companies" class="btn btn-sm btn-ghost"><%= ngt("common.view_all") %> <i class="bi bi-chevron-right sa-go"></i></a>
    </div>
    <% if m[:recent_companies].empty? %>
      <div class="sa-empty">
        <app-empty-state><%= render layout: "web/shared/empty_state", locals: { title: ngt("superadmin.no_companies"), body: "", icon: "bi-buildings" } do %><% end %></app-empty-state>
      </div>
    <% else %>
      <div class="sa-scroll" data-controller="data-table">
        <table class="table sa-grid">
          <tbody>
            <% m[:recent_companies].each do |company| %>
              <% href = "/superadmin/companies/#{company[:id]}" %>
              <tr class="sa-row" data-action="click->data-table#open" data-href="<%= href %>">
                <td>
                  <div class="sa-lead">
                    <span class="sa-lead-ico"><i class="bi bi-building"></i></span>
                    <div>
                      <a class="sa-lead-title" href="<%= href %>"><%= company[:name] %></a>
                      <div class="sa-sub"><%= company[:admin_name] %><% if company[:city].present? %> · <%= company[:city] %><% end %></div>
                    </div>
                  </div>
                </td>
                <td>
                  <% status, words = superadmin_activation(company[:activation_state]) %>
                  <% unless status == "active" %>
                    <app-status-badge><%= render layout: "web/shared/status_badge", locals: { status: status } do %><%= words %><% end %></app-status-badge>
                  <% end %>
                </td>
                <td class="sa-num sa-sub"><%= ng_date(company[:created_at], "d MMM") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>

  <section class="app-card">
    <div class="app-card-header"><h2><%= ngt("superadmin.console.to_handle") %></h2></div>
    <ul class="sa-quick">
      <li>
        <a href="/superadmin/companies?activation=pending">
          <i class="bi bi-envelope-paper"></i> <%= ngt("superadmin.console.awaiting_activation") %>
          <span class="sa-quick-count"><%= waiting %></span>
        </a>
      </li>
      <li>
        <a href="/superadmin/support">
          <i class="bi bi-headset"></i> <%= ngt("superadmin.console.open_tickets") %>
          <span class="sa-quick-count"><%= @open_tickets %></span>
        </a>
      </li>
      <li>
        <a href="/superadmin/updates">
          <i class="bi bi-megaphone"></i> <%= ngt("superadmin.console.latest_update") %>
          <span class="sa-quick-count"><%= @latest_update ? "v#{@latest_update.version}" : "—" %></span>
        </a>
      </li>
    </ul>
    <div class="app-card-body">
      <h3 class="sa-sub mb-2"><%= ngt("superadmin.overview.usage") %></h3>
      <p class="mb-0"><%= ngt("superadmin.overview.usage_line", sessions: m.dig(:activity, :sessions_last_30_days), bookings: m.dig(:activity, :bookings_last_30_days)) %></p>
    </div>
  </section>
</div>
