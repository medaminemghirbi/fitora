<%# ng: client-profile %>
<%# ng-host: client-profile %>
<%# ClientProfileComponent: the file (_body) and the dialogs the desk opens
    from it — a booking, a payment, the health file, their details (client-profile) — and
    the subscription dialogs, the subscriptions page's own (subscriptions). %>
<div data-controller="subscriptions" <%= subscription_controller_attributes(member: @member) %>>
<div class="fx-page" data-controller="client-profile"
     data-client-profile-url-value="<%= admin_page_path("clients/#{@client.id}") %>"
     data-client-profile-payments-url-value="<%= admin_page_path("payments") %>"
     data-client-profile-attendance-url-value="<%= admin_page_path("attendance") %>"
     data-client-profile-clients-url-value="<%= admin_page_path("clients") %>"
     data-client-profile-drop-in-value="<%= bootstrap.dig(:features, :drop_in) != false %>"
     data-client-profile-today-value="<%= Date.current.iso8601 %>"
     data-client-profile-labels-value="<%= client_profile_labels.to_json %>"
     data-action="modal:opened@window->client-profile#fill subscriptions:changed@window->client-profile#load member-photo:changed@window->client-profile#load">
  <%= render "web/admin/client_profiles/body", p: @profile %>
</div>

<app-modal data-controller="modal" data-modal-name-value="profile-booking" data-action="profile-booking:open@window->modal#open profile-booking:close@window->modal#close">
  <template data-modal-target="template">
    <%= render layout: "web/shared/modal", locals: { title: ngt("clients.add_booking") } do %>
      <form novalidate data-profile-form="booking">
        <div class="mb-3">
          <label for="bk-activity"><%= ngt("activities.title") %> *</label>
          <select id="bk-activity" class="form-select" name="activity_id">
            <option value="" disabled selected>—</option>
            <% @activities.each do |a| %>
              <option value="<%= a[:id] %>"><%= a[:emoji].to_s != "" ? "#{a[:emoji]} " : "" %><%= a[:name] %></option>
            <% end %>
          </select>
        </div>
        <div class="mb-3">
          <label for="bk-date"><%= ngt("bookings.date") %> *</label>
          <input id="bk-date" type="date" class="form-control" name="date" />
        </div>
        <div class="mb-3">
          <label for="bk-session"><%= ngt("schedule.title") %> *</label>
          <select id="bk-session" class="form-select" name="session_id">
            <option value="" disabled selected>—</option>
          </select>
          <div class="form-text mt-1" data-no-sessions><%= ngt("clients.no_sessions_available") %></div>
        </div>
        <% if bootstrap.dig(:features, :drop_in) != false %>
          <fieldset class="mb-3">
            <legend class="form-label mb-1"><%= ngt("bookings.kind_label") %></legend>
            <% %w[contract trial drop_in].each do |kind| %>
              <div class="form-check">
                <input id="bk-kind-<%= kind %>" type="radio" class="form-check-input" name="kind" value="<%= kind %>" />
                <label for="bk-kind-<%= kind %>" class="form-check-label"><%= ngt("bookings.kind_#{kind}") %></label>
              </div>
            <% end %>
            <p class="form-text mb-0" data-kind-hint></p>
          </fieldset>
        <% end %>
        <div class="d-flex justify-content-end gap-2 mt-4">
          <button type="button" class="btn btn-outline-secondary" data-action="modal#close"><%= ngt("common.cancel") %></button>
          <button type="submit" class="btn btn-primary" data-save><%= ngt("common.save") %></button>
        </div>
      </form>
    <% end %>
  </template>
</app-modal>

<app-modal data-controller="modal" data-modal-name-value="profile-payment" data-action="profile-payment:open@window->modal#open profile-payment:close@window->modal#close">
  <template data-modal-target="template">
    <%= render layout: "web/shared/modal", locals: { title: ngt("clients.add_payment") } do %>
      <form novalidate data-profile-form="payment">
        <div class="mb-3">
          <label for="pm-payable"><%= ngt("payments.for") %> *</label>
          <select id="pm-payable" class="form-select" name="payable_key">
            <option value="" disabled selected>—</option>
          </select>
          <div class="form-text mt-1" data-nothing-outstanding><%= ngt("payments.nothing_outstanding") %></div>
        </div>
        <%= render "web/admin/payments/method_choice" %>
        <p class="fx-muted" style="font-size: 0.8125rem"><%= ngt("clients.abo_pay_full_hint") %></p>
        <div class="d-flex justify-content-end gap-2 mt-4">
          <button type="button" class="btn btn-outline-secondary" data-action="modal#close"><%= ngt("common.cancel") %></button>
          <button type="submit" class="btn btn-primary" data-save>
            <%= ngt("common.save") %>
          </button>
        </div>
      </form>
    <% end %>
  </template>
</app-modal>

<app-modal data-controller="modal" data-modal-name-value="profile-health" data-action="profile-health:open@window->modal#open profile-health:close@window->modal#close">
  <template data-modal-target="template">
    <%= render layout: "web/shared/modal", locals: { title: ngt("clients.health_title") } do %>
      <form novalidate data-profile-form="health">
        <div class="mb-3">
          <label for="hl-notes"><%= ngt("clients.health_notes") %></label>
          <textarea id="hl-notes" class="form-control" rows="4" name="health_notes" placeholder="<%= ngt("clients.health_notes_placeholder") %>"></textarea>
          <p class="form-text mb-0"><%= ngt("clients.health_notes_hint") %></p>
        </div>
        <div class="mb-3">
          <label for="hl-waiver"><%= ngt("clients.waiver_signed_on") %></label>
          <div class="d-flex gap-2">
            <input id="hl-waiver" type="date" class="form-control" name="waiver_signed_on" />
            <button type="button" class="btn btn-outline-secondary prof-waiver-today" data-waiver-today><%= ngt("clients.waiver_today") %></button>
          </div>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
          <button type="button" class="btn btn-outline-secondary" data-action="modal#close"><%= ngt("common.cancel") %></button>
          <button type="submit" class="btn btn-primary" data-save><%= ngt("common.save") %></button>
        </div>
      </form>
    <% end %>
  </template>
</app-modal>

<app-modal data-controller="modal" data-modal-name-value="profile-details" data-action="profile-details:open@window->modal#open profile-details:close@window->modal#close">
  <template data-modal-target="template">
    <%= render layout: "web/shared/modal", locals: { title: ngt("clients.edit_title") } do %>
      <form novalidate data-profile-form="details">
        <p class="form-text mt-0 mb-3" data-locked-hint><%= ngt("clients.identity_locked_hint") %></p>
        <div class="row">
          <div class="col-6 mb-3">
            <label for="dt-first"><%= ngt("coaches.first_name") %> *</label>
            <input id="dt-first" class="form-control" name="first_name" autocomplete="off" />
          </div>
          <div class="col-6 mb-3">
            <label for="dt-last"><%= ngt("coaches.last_name") %> *</label>
            <input id="dt-last" class="form-control" name="last_name" autocomplete="off" />
          </div>
        </div>
        <div class="row">
          <div class="col-12 col-sm-6 mb-3">
            <label for="dt-phone"><%= ngt("auth.phone") %> *</label>
            <input id="dt-phone" type="tel" class="form-control" name="phone" dir="ltr" autocomplete="off" />
          </div>
          <div class="col-12 col-sm-6 mb-3">
            <label for="dt-email"><%= ngt("auth.email") %></label>
            <input id="dt-email" type="email" class="form-control" name="email" dir="ltr" autocomplete="off" />
            <div class="form-text" data-email-keep><%= ngt("clients.email_keep_hint") %></div>
          </div>
        </div>
        <div class="row">
          <div class="col-6 mb-3">
            <label for="dt-birth"><%= ngt("clients.date_of_birth") %></label>
            <input id="dt-birth" type="date" class="form-control" name="date_of_birth" />
          </div>
          <div class="col-6 mb-3">
            <label for="dt-gender"><%= ngt("clients.gender") %></label>
            <select id="dt-gender" class="form-select" name="gender">
              <option value="">—</option>
              <option value="male"><%= ngt("clients.gender_male") %></option>
              <option value="female"><%= ngt("clients.gender_female") %></option>
            </select>
          </div>
        </div>
        <div class="mb-3">
          <label for="dt-address"><%= ngt("settings.address_title") %></label>
          <input id="dt-address" class="form-control" name="address" autocomplete="off" />
        </div>
        <div class="row">
          <div class="col-12 col-sm-6 mb-3">
            <label for="dt-ec-name"><%= ngt("clients.emergency_contact_name") %></label>
            <input id="dt-ec-name" class="form-control" name="emergency_contact_name" autocomplete="off" />
          </div>
          <div class="col-12 col-sm-6 mb-3">
            <label for="dt-ec-phone"><%= ngt("clients.emergency_contact_phone") %></label>
            <input id="dt-ec-phone" type="tel" class="form-control" name="emergency_contact_phone" dir="ltr" autocomplete="off" />
          </div>
        </div>
        <div class="mb-3">
          <label for="dt-notes"><%= ngt("clients.notes") %></label>
          <textarea id="dt-notes" class="form-control" rows="2" name="notes"></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-4">
          <button type="button" class="btn btn-outline-secondary" data-action="modal#close"><%= ngt("common.cancel") %></button>
          <button type="submit" class="btn btn-primary" data-save><%= ngt("common.save") %></button>
        </div>
      </form>
    <% end %>
  </template>
</app-modal>

<%= render "web/admin/contracts/dialogs" if may_sell? %>
</div>
