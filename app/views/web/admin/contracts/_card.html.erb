<%# The table (or the empty state) and the pagination. One row a term: who,
    what, when (and what is left of it), its state, what is owed, and what
    to do about it. %>
<div class="app-card abo-card" id="ct-card" data-contracts-list-target="card">
  <% if contracts.empty? %>
    <div class="app-card-body">
      <% filtered = filters[:q].present? || filters[:status].present? || filters[:contract_type_id].present? %>
      <app-empty-state><%= render layout: "web/shared/empty_state", locals: { title: ngt(filtered ? "contracts.empty_filtered_title" : "contracts.empty_title"), body: ngt(filtered ? "contracts.empty_filtered_body" : "contracts.empty_body"), icon: "bi-person-badge" } do %>
        <% unless filtered %>
          <button type="button" class="btn btn-primary" data-action="subscriptions#sell">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> <%= ngt("contracts.sell") %>
          </button>
        <% end %>
      <% end %></app-empty-state>
    </div>
  <% else %>
    <div class="fx-table-scroll">
      <table class="table abo-table">
        <thead>
          <tr>
            <th><%= ngt("contracts.col_member") %></th>
            <th><%= ngt("contracts.col_subscription") %></th>
            <th><%= ngt("contracts.col_period") %></th>
            <th><%= ngt("contracts.col_state") %></th>
            <th><%= ngt("contracts.col_payment") %></th>
            <th class="text-end"><span class="visually-hidden"><%= ngt("common.actions") %></span></th>
          </tr>
        </thead>
        <tbody>
          <% contracts.each do |m| %>
            <tr data-state="<%= m[:state] %>">
              <td>
                <a class="abo-member" href="<%= admin_page_path("clients/#{m.dig(:client, :id)}") %>">
                  <app-avatar><%= render "web/shared/avatar", name: m.dig(:client, :full_name).to_s, size: 34 %></app-avatar>
                  <span class="abo-member-text">
                    <span class="abo-member-name"><%= ng_highlight(m.dig(:client, :full_name), filters[:q]) %></span>
                    <% if m.dig(:client, :phone).present? %><span class="abo-sub" dir="ltr"><%= m.dig(:client, :phone) %></span><% end %>
                  </span>
                </a>
              </td>
              <td>
                <span class="abo-formule">
                  <span class="abo-dot" style="background: <%= m.dig(:plan, :color) %>;" aria-hidden="true"></span>
                  <span>
                    <span class="abo-formule-name"><%= subscription_covers(m) %></span>
                    <span class="abo-sub"><%= ng_highlight(m.dig(:plan, :name), filters[:q]) %></span>
                    <span class="abo-sub abo-ref" dir="ltr"><%= ng_highlight(m[:invoice_ref], filters[:q]) %></span>
                  </span>
                </span>
              </td>
              <td class="abo-period">
                <span class="fx-num" dir="ltr"><%= ng_date(m[:starts_at], "dd/MM/yy").presence || "—" %> → <%= ng_date(m[:expires_at], "dd/MM/yy").presence || "—" %></span>
                <% notes = [ subscription_period_note(m), subscription_sessions_note(m) ].compact %>
                <% if notes.any? %><span class="abo-sub"><%= notes.join(" · ") %></span><% end %>
              </td>
              <td>
                <span class="abo-state" data-state="<%= m[:state] %>"><%= subscription_state_label(m) %></span>
                <% if (renewal = m[:renewal]) %>
                  <span class="abo-sub abo-renewed"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> <%= ngt("contracts.renewed_until", date: ng_date(renewal[:expires_at], "dd/MM/yy")) %></span>
                <% end %>
              </td>
              <td class="abo-payment">
                <% if m[:state] == "cancelled" %>
                  <span class="abo-sub">—</span>
                <% elsif m[:amount_due].to_f > 0 %>
                  <span class="abo-due"><%= ng_money(m[:amount_due], m.dig(:plan, :currency)) %></span>
                  <span class="abo-sub"><%= ngt("contracts.to_collect") %></span>
                <% else %>
                  <span class="abo-paid"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> <%= ngt("contracts.paid") %></span>
                  <span class="abo-sub"><%= ng_money(m[:final_price], m.dig(:plan, :currency)) %></span>
                <% end %>
              </td>
              <td class="text-end">
                <%= render "web/admin/contracts/row_actions", m: m, profile: false %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <app-pagination><%= render "web/shared/pagination", meta: meta, action: "contracts-list#goToPage" %></app-pagination>
  <% end %>
</div>
