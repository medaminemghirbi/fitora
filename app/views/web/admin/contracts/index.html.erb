<%# The subscriptions page: one button to sell, the work lists as tabs (what
    to renew, what lapsed, what is owed…), a search and a formule filter,
    the table — re-asked on every change (contracts-list) — and the dialogs
    every row's actions open (subscriptions, shared with the member's file). %>
<div class="abo-page" data-controller="contracts-list subscriptions"
     data-contracts-list-url-value="<%= admin_page_path("contracts") %>"
     data-contracts-list-filters-value="<%= { q: @filters[:q].to_s, status: @filters[:status].to_s, contract_type_id: @filters[:contract_type_id].to_s }.to_json %>"
     data-contracts-list-page-value="<%= @page %>"
     data-contracts-list-labels-value="<%= { reset: ngt("common.reset") }.to_json %>"
     <%= subscription_controller_attributes(member: nil) %>
     data-action="subscriptions:changed@window->contracts-list#load">
  <header class="abo-head">
    <div class="abo-head-titles">
      <h1><%= ngt("contracts.title") %></h1>
      <p><%= ngt("contracts.subtitle") %></p>
    </div>
    <button type="button" class="btn btn-primary" data-action="subscriptions#sell">
      <i class="bi bi-plus-lg" aria-hidden="true"></i> <%= ngt("contracts.sell") %>
    </button>
  </header>

  <%= render "web/admin/contracts/lists", counts: @counts, filters: @filters %>

  <div class="abo-toolbar">
    <div class="abo-search fx-input-icon">
      <i class="bi bi-search" aria-hidden="true"></i>
      <input type="search" class="form-control" value="<%= @filters[:q] %>"
             placeholder="<%= ngt("contracts.search_placeholder") %>" aria-label="<%= ngt("contracts.search_placeholder") %>"
             data-contracts-list-target="search" data-action="input->contracts-list#searchChanged" />
    </div>
    <%= render "web/admin/contracts/plan_filter", plans: @plans, plan_counts: @plan_counts, filters: @filters %>
  </div>

  <%= render "web/admin/contracts/totals", totals: @totals %>

  <%= render "web/admin/contracts/card", contracts: @contracts, meta: @meta, filters: @filters %>

  <template data-contracts-list-target="loadingTemplate">
    <div class="app-card-body"><app-skeleton><%= render "web/shared/skeleton_table", rows: 8, cols: 6 %></app-skeleton></div>
  </template>
  <template data-contracts-list-target="errorTemplate">
    <div class="app-card-body"><app-error-state><%= render "web/shared/error_state", retry_action: "contracts-list#retry" %></app-error-state></div>
  </template>

  <%= render "web/admin/contracts/dialogs", member: nil %>
</div>
