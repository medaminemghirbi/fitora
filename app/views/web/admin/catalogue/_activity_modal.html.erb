<%# ng: activities %>
<%# The activity form, blank or filled by the catalogue controller when it
    opens (openCreate / openEdit). %>
<% emojis = %w[🏋️ 💪 🤸 🧘 🥊 🥋 🚴 🏃 🏊 ⚡ 🤾 🏓 🏸 ⚽ 🏀 🏐 🕺 💃 🩰 🥇 🔥 🕉️ 🏹 🎽] %>
<app-modal data-controller="modal" data-modal-name-value="catalogue-activity" data-action="catalogue-activity:open@window->modal#open catalogue-activity:close@window->modal#close">
  <template data-modal-target="template">
    <%= render layout: "web/shared/modal", locals: { title: ngt("activities.new") } do %>
      <form novalidate data-activity-form>
        <div class="row">
          <div class="col-9 mb-3">
            <label for="act-name"><%= ngt("activities.name") %> *</label>
            <input id="act-name" class="form-control" name="name" />
          </div>
          <div class="col-3 mb-3">
            <label for="act-emoji"><%= ngt("activities.emoji") %></label>
            <input id="act-emoji" class="form-control text-center" name="emoji" placeholder="🏋️" maxlength="4" />
          </div>
        </div>
        <div class="emoji-picker mb-3">
          <% emojis.each do |e| %>
            <button type="button" class="emoji-picker-btn" aria-label="<%= e %>" data-emoji="<%= e %>">
              <%= e %>
            </button>
          <% end %>
        </div>
        <div class="mb-3">
          <label for="act-format"><%= ngt("activities.format") %> *</label>
          <select id="act-format" class="form-select" name="session_format">
            <% %w[individual small_group collective].each do |format| %>
              <option value="<%= format %>"><%= ngt("activities.format_#{format}") %></option>
            <% end %>
          </select>
          <div class="form-text" data-format-hint></div>
        </div>
        <div class="row">
          <div class="col-6 mb-3">
            <label for="act-duration"><%= ngt("activities.duration") %> *</label>
            <input id="act-duration" type="number" min="1" class="form-control" name="duration" />
          </div>
          <div class="col-6 mb-3" data-capacity-field>
            <label for="act-capacity"><%= ngt("activities.capacity") %> *</label>
            <input id="act-capacity" type="number" class="form-control" name="capacity" />
          </div>
        </div>
        <div class="mb-3">
          <label for="act-description"><%= ngt("activities.description") %></label>
          <textarea id="act-description" class="form-control" rows="2" name="description"></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
          <button type="button" class="btn btn-outline-secondary" data-action="modal#close"><%= ngt("common.cancel") %></button>
          <button type="submit" class="btn btn-primary" data-save>
            <%= ngt("common.save") %>
          </button>
        </div>
      </form>
    <% end %>
  </template>
</app-modal>
