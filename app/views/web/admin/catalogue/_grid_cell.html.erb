<%# ng: price-grid %>
<td class="pg-cell<%= " is-empty" if price.nil? %>" data-plan="<%= plan[:id] %>" data-kind="<%= kind %>" data-id="<%= id %>" data-price="<%= js_number(price) %>">
  <input type="text" inputmode="decimal" class="pg-input" value="<%= js_number(price) %>" placeholder="—" aria-label="<%= label %>"
         data-action="keydown->catalogue#gridKey blur->catalogue#gridCommit" />
</td>
