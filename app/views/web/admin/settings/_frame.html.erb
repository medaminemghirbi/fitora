<%# Around every settings page: the settings' own menu, grouped by what each
    section is about, and a picker in its place on a phone. %>
<div class="set" data-controller="settings-shell">
  <nav class="set-nav" aria-label="<%= ngt("settings.title") %>">
    <div class="set-nav-head">
      <a href="<%= nav.path(nav.home_page) %>" class="set-back">
        <i class="bi bi-arrow-left" aria-hidden="true"></i>
        <%= ngt("settings.back_to_gym") %>
      </a>
      <p class="set-nav-title"><%= ngt("settings.title") %></p>
      <label class="set-search">
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" placeholder="<%= ngt("settings.search_placeholder") %>" aria-label="<%= ngt("settings.search_placeholder") %>"
               data-action="input->settings-shell#filter keydown.enter->settings-shell#openFirst" />
      </label>
    </div>

    <% sections.groups.each do |group| %>
      <div class="set-nav-group<%= " is-own" if group.key == "account" %>" data-settings-shell-target="group">
        <span class="set-nav-label"><%= ngt(group.label_key) %></span>
        <% group.sections.each do |s| %>
          <% active = s.path == current_settings_path %>
          <a href="<%= admin_page_path(s.target) %>" class="set-nav-item<%= " is-active" if active %>"<%= raw(' aria-current="page"') if active %>
             data-settings-shell-target="item" data-search="<%= ngt(s.label_key) %> <%= ngt(s.keywords_key) %>">
            <span><%= ngt(s.label_key) %></span>
            <% if needs_attention?(s) %>
              <span class="set-dot" role="img" aria-label="<%= ngt("settings.to_complete") %>" title="<%= ngt("settings.to_complete") %>"></span>
            <% end %>
          </a>
        <% end %>
      </div>
    <% end %>
    <p class="set-nav-empty" hidden data-settings-shell-target="empty"><%= ngt("common.no_results") %></p>

    <% if current_user.admin? %>
      <a href="<%= admin_page_path("onboarding") %>" class="set-nav-start">
        <i class="bi bi-compass" aria-hidden="true"></i>
        <%= ngt("onboarding.card_title") %>
      </a>
    <% end %>
  </nav>

  <div class="set-main">
    <select class="form-select set-picker" aria-label="<%= ngt("settings.title") %>" data-action="settings-shell#pick">
      <% sections.groups.each do |group| %>
        <optgroup label="<%= ngt(group.label_key) %>">
          <% group.sections.each do |s| %>
            <option value="<%= admin_page_path(s.target) %>"<%= raw(" selected") if s.path == current_settings_path %>>
              <%= ngt(s.label_key) %>
            </option>
          <% end %>
        </optgroup>
      <% end %>
    </select>

    <%= yield %>
  </div>
</div>
