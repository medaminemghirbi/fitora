<%# The gym's profile, what its documents print at their head: saved by
    settings-company, drawn as it is typed by settings-preview. %>
<div class="set-layout" data-controller="settings-preview"
     data-settings-preview-values-value="<%= settings_preview_values(company).to_json %>"
     data-action="input->settings-preview#update focusin->settings-preview#light focusout->settings-preview#dim">
  <form class="set-form" novalidate data-controller="settings-company settings-dirty" data-settings-company-target="form"
        data-settings-company-url-value="<%= admin_page_path("settings/company") %>"
        data-settings-company-labels-value="<%= { saved: ngt("common.saved"), save: ngt("common.save"), saving: ngt("common.saving"), error: ngt("common.error_generic") }.to_json %>"
        data-action="submit->settings-company#submit">
    <div class="set-row">
      <div>
        <label class="set-row-title" for="org-name"><%= ngt("settings.company_name") %> *</label>
        <p class="set-row-hint"><%= ngt("settings.company_name_hint") %></p>
      </div>
      <input id="org-name" class="form-control" name="name" value="<%= company[:name] %>" />
    </div>

    <div class="set-row">
      <div>
        <label class="set-row-title" for="org-description"><%= ngt("activities.description") %></label>
        <p class="set-row-hint"><%= ngt("settings.description_hint") %></p>
      </div>
      <textarea id="org-description" class="form-control" rows="2" name="description"><%= company[:description] %></textarea>
    </div>

    <div class="set-row">
      <div>
        <span class="set-row-title"><%= ngt("settings.contact_title") %></span>
        <p class="set-row-hint"><%= ngt("settings.contact_hint") %></p>
      </div>
      <div class="set-fields">
        <div class="set-field">
          <label for="org-phone"><%= ngt("auth.phone") %></label>
          <input id="org-phone" class="form-control" name="phone" dir="ltr" value="<%= company[:phone] %>" />
        </div>
        <div class="set-field">
          <label for="org-email"><%= ngt("auth.email") %></label>
          <input id="org-email" type="email" class="form-control" name="email" dir="ltr" value="<%= company[:email] %>" />
        </div>
      </div>
    </div>

    <div class="set-row">
      <div>
        <span class="set-row-title"><%= ngt("settings.address_title") %></span>
        <p class="set-row-hint"><%= ngt("settings.address_hint") %></p>
      </div>
      <div class="set-fields">
        <div class="set-field">
          <label for="org-address"><%= ngt("company_setup.gym_address") %></label>
          <input id="org-address" class="form-control" name="address" value="<%= company[:address] %>" placeholder="<%= ngt("company_setup.gym_address_hint") %>" />
        </div>
        <div class="set-field">
          <label for="org-city"><%= ngt("settings.company_city") %></label>
          <input id="org-city" class="form-control" name="city" value="<%= company[:city] %>" />
        </div>
      </div>
    </div>

    <%= render "web/admin/settings/save_bar" %>
  </form>

  <%= render "web/admin/settings/preview", company: company, docs: %w[receipt contract] %>
</div>
