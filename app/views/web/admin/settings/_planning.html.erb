<%# The working days, as toggle buttons Monday first, and the calendar's hours
    (settings-planning). %>
<% days = [ [ 1, "common.dow_mon" ], [ 2, "common.dow_tue" ], [ 3, "common.dow_wed" ], [ 4, "common.dow_thu" ], [ 5, "common.dow_fri" ], [ 6, "common.dow_sat" ], [ 0, "common.dow_sun" ] ] %>
<% working = Array(company[:working_days] || [ 1, 2, 3, 4, 5 ]) %>
<form class="set-form" novalidate data-controller="settings-planning settings-dirty"
      data-settings-planning-url-value="<%= admin_page_path("settings/company") %>"
      data-settings-planning-days-value="<%= working.to_json %>"
      data-settings-planning-labels-value="<%= { saved: ngt("common.saved"), save: ngt("common.save"), saving: ngt("common.saving"), error: ngt("common.error_generic"), days_required: ngt("settings.working_days_required") }.to_json %>"
      data-action="submit->settings-planning#submit">
  <div class="set-row">
    <div>
      <span class="set-row-title"><%= ngt("settings.working_days") %></span>
      <p class="set-row-hint"><%= ngt("settings.working_days_hint") %></p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% days.each do |value, label| %>
        <% on = working.include?(value) %>
        <button type="button" class="btn btn-sm <%= on ? "btn-primary" : "btn-outline-secondary" %>" aria-pressed="<%= on %>" data-day="<%= value %>" data-action="settings-planning#toggle">
          <%= ngt(label) %>
        </button>
      <% end %>
    </div>
  </div>

  <div class="set-row">
    <div>
      <span class="set-row-title"><%= ngt("settings.calendar") %></span>
      <p class="set-row-hint"><%= ngt("settings.calendar_hint") %></p>
    </div>
    <div class="set-fields-pair">
      <div class="set-field">
        <label for="cal-hours-start"><%= ngt("settings.business_hours_start") %> *</label>
        <input id="cal-hours-start" type="time" class="form-control" name="business_hours_start" value="<%= company[:business_hours_start] %>" />
      </div>
      <div class="set-field">
        <label for="cal-hours-end"><%= ngt("settings.business_hours_end") %> *</label>
        <input id="cal-hours-end" type="time" class="form-control" name="business_hours_end" value="<%= company[:business_hours_end] %>" />
      </div>
    </div>
  </div>

  <%= render "web/admin/settings/save_bar" %>
</form>
