<%# What the law and the clock need to know: the matricule fiscal, the country
    and its time zone (filled in by settings-company), and the currency and
    language Fitora manages. Saved by settings-company. %>
<div class="set-layout" data-controller="settings-preview"
     data-settings-preview-values-value="<%= settings_preview_values(company).to_json %>"
     data-action="input->settings-preview#update focusin->settings-preview#light focusout->settings-preview#dim">
  <form class="set-form" novalidate data-controller="settings-company settings-dirty" data-settings-company-target="form"
        data-settings-company-url-value="<%= admin_page_path("settings/company") %>"
        data-settings-company-country-value="<%= company[:country] %>"
        data-settings-company-timezone-value="<%= company[:timezone] %>"
        data-settings-company-labels-value="<%= { saved: ngt("common.saved"), save: ngt("common.save"), saving: ngt("common.saving"), error: ngt("common.error_generic") }.to_json %>"
        data-action="submit->settings-company#submit">
    <div class="set-row">
      <div>
        <label class="set-row-title" for="org-tax-id"><%= ngt("settings.tax_id") %></label>
        <p class="set-row-hint"><%= ngt("settings.tax_id_hint") %></p>
      </div>
      <input id="org-tax-id" class="form-control" name="tax_id" maxlength="40" dir="ltr" value="<%= company[:tax_id] %>" placeholder="<%= ngt("settings.tax_id_placeholder") %>" />
    </div>

    <div class="set-row">
      <div>
        <label class="set-row-title" for="org-country"><%= ngt("company_setup.country") %></label>
        <p class="set-row-hint"><%= ngt("settings.country_hint") %></p>
      </div>
      <div>
        <input type="hidden" name="country" value="<%= company[:country] %>" />
        <app-searchable-select data-controller="searchable-select" data-searchable-select-id-value="org-country"
                               data-searchable-select-placeholder-value="<%= ngt("company_setup.select_country") %>"
                               data-searchable-select-search-value="<%= ngt("common.search") %>"
                               data-searchable-select-empty-value="<%= ngt("common.no_results") %>"
                               data-settings-company-target="country"></app-searchable-select>
      </div>
    </div>

    <div class="set-row">
      <div>
        <label class="set-row-title" for="org-timezone"><%= ngt("company_setup.timezone") %> *</label>
        <p class="set-row-hint"><%= ngt("settings.timezone_hint") %></p>
      </div>
      <select id="org-timezone" class="form-select" name="timezone"></select>
    </div>

    <div class="set-row">
      <div>
        <span class="set-row-title"><%= ngt("settings.currency") %></span>
        <p class="set-row-hint"><%= ngt("settings.currency_language_managed") %></p>
      </div>
      <p class="set-static"><%= ngt("currency.#{company[:currency]}") %> — <%= company[:currency_symbol] %> (<%= company[:currency] %>)</p>
    </div>

    <div class="set-row">
      <span class="set-row-title"><%= ngt("settings.company_language") %></span>
      <p class="set-static"><%= ngt("language.#{company[:locale]}") %></p>
    </div>

    <%= render "web/admin/settings/save_bar" %>
  </form>

  <%= render "web/admin/settings/preview", company: company, docs: %w[receipt contract] %>
</div>
