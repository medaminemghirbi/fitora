<%# The section the URL names, inside the settings' menu (settings/_frame). %>
<% roles_labels = { saved: ngt("settings.role_saved"), deleted: ngt("common.delete"), error: ngt("common.error_generic"), save: ngt("common.save"), saving: ngt("common.saving"),
                   create: ngt("settings.role_create"), rename: ngt("settings.role_rename"), new: ngt("settings.role_new"), name_required: ngt("settings.role_name_required"),
                   changes_one: ngt("settings.role_changes_one"), changes_many: Web::Translations.translate("settings.role_changes_many", {}, locale: I18n.locale),
                   perm_count: Web::Translations.translate("settings.role_perm_count", {}, locale: I18n.locale),
                   discard_title: ngt("settings.role_discard_title"), discard_body: ngt("settings.role_discard_body"), discard_confirm: ngt("settings.role_discard_confirm"),
                   delete_title: Web::Translations.translate("settings.role_delete_title", {}, locale: I18n.locale), delete_body: ngt("settings.role_delete_body"),
                   groups: %w[front planning sales insights other].to_h { |g| [ g, ngt("settings.role_group_#{g}") ] } }.to_json %>
<% branding_labels = { saved: ngt("common.saved"), save: ngt("common.save"), saving: ngt("common.saving"), error: ngt("common.error_generic"), type_error: ngt("settings.signature_type_error"), will_replace: ngt("settings.signature_will_replace"), replace_hint: ngt("settings.signature_replace_hint"), signature: ngt("settings.signature") }.to_json %>
<section class="set-main-section" aria-labelledby="settings-sec-h">
  <header class="set-main-head">
    <h1 id="settings-sec-h"><%= ngt(section.label_key) %></h1>
    <p><%= ngt(section.desc_key) %></p>
  </header>

  <% if section.path == "company" %>
    <app-settings-company><%= render "web/admin/settings/company", company: @company %></app-settings-company>
  <% elsif section.path == "legal" %>
    <app-settings-company><%= render "web/admin/settings/legal", company: @company %></app-settings-company>
  <% elsif section.path == "branding" %>
    <app-settings-branding data-controller="settings-branding" data-settings-branding-url-value="<%= admin_page_path("settings/company") %>" data-settings-branding-labels-value="<%= branding_labels %>"><%= render "web/admin/settings/branding", company: @company, part: "brand" %></app-settings-branding>
  <% elsif section.path == "contracts" %>
    <app-settings-branding data-controller="settings-branding settings-preview" data-settings-branding-url-value="<%= admin_page_path("settings/company") %>" data-settings-branding-labels-value="<%= branding_labels %>"
                           data-settings-preview-values-value="<%= settings_preview_values(@company).to_json %>"
                           data-action="settings-branding:signature->settings-preview#signatureChanged input->settings-preview#update focusin->settings-preview#light focusout->settings-preview#dim"><%= render "web/admin/settings/branding", company: @company, part: "contracts" %></app-settings-branding>
  <% elsif section.path == "planning" %>
    <app-settings-planning><%= render "web/admin/settings/planning", company: @company %></app-settings-planning>
  <% elsif section.path == "booking" %>
    <div class="set-narrow">
      <p class="set-note"><i class="bi bi-check-lg" aria-hidden="true"></i> <%= ngt("settings.autosave_note") %></p>
      <app-settings-booking data-controller="settings-booking" data-settings-booking-url-value="<%= admin_page_path("settings/company") %>"
                            data-settings-booking-labels-value="<%= { saved: ngt("common.saved"), error: ngt("common.error_generic") }.to_json %>"><%= render "web/admin/settings/booking", company: @company %></app-settings-booking>
    </div>
  <% elsif section.path == "roles" %>
    <app-settings-roles data-controller="settings-roles" data-settings-roles-url-value="<%= admin_page_path("settings/roles") %>"
                        data-settings-roles-labels-value="<%= roles_labels %>"><%= render "web/admin/settings/roles", data: @roles %></app-settings-roles>
  <% elsif section.path == "mobile-app" %>
    <app-settings-mobile-app data-controller="settings-mobile-app" data-settings-mobile-app-url-value="<%= admin_page_path("settings/mobile-app/regenerate") %>"
                             data-settings-mobile-app-labels-value="<%= { copied: ngt("settings.mobile_copied"), error: ngt("common.error_generic"), title: ngt("settings.mobile_regenerate_title"), body: ngt("settings.mobile_regenerate_body"), done: ngt("settings.mobile_regenerated") }.to_json %>"><%= render "web/admin/settings/mobile_app", keys: @keys %></app-settings-mobile-app>
  <% elsif section.path == "appearance" %>
    <div class="set-narrow"><app-settings-appearance><%= render "web/admin/settings/appearance" %></app-settings-appearance></div>
  <% elsif section.path == "account" %>
    <div class="set-narrow"><app-change-password><%= render "web/shared/change_password" %></app-change-password></div>
  <% end %>
</section>
