<%# ng: pro-login %>
<%# ng-host: pro-login %>
<%# ProLoginComponent (features/b2b/auth/pro-login.component.html). The
    checks the Angular form makes before sending — both fields required, the
    e-mail well-formed — are made here too (form-checks controller), with the
    same "touched" rules; the server makes them again. %>
<% content_for :auth_panel do %>
  <div authPanel class="auth-panel">
    <span class="auth-panel-badge"><i aria-hidden="true"></i><%= ngt("auth.login_panel_badge") %></span>
    <p class="auth-panel-title">
      <%= ngt("auth.login_panel_title_1") %>
      <em><%= ngt("auth.login_panel_title_2") %></em>
    </p>
    <div class="auth-today">
      <div class="auth-today-head">
        <div>
          <span class="auth-panel-kicker"><%= ngt("auth.login_panel_kicker") %></span>
          <span class="auth-today-date"><%= @today_label %></span>
        </div>
      </div>
      <ul class="auth-today-list">
        <li><i class="bi bi-calendar3" aria-hidden="true"></i><%= ngt("auth.login_panel_item_planning") %></li>
        <li><i class="bi bi-arrow-repeat" aria-hidden="true"></i><%= ngt("auth.login_panel_item_renewals") %></li>
        <li><i class="bi bi-cash-coin" aria-hidden="true"></i><%= ngt("auth.login_panel_item_payments") %></li>
      </ul>
    </div>
  </div>
<% end %>
<app-auth-pro-shell>
  <%= render layout: "web/shared/auth_pro_shell" do %>
    <h1 class="auth-title"><%= ngt("auth.sign_in") %></h1>
    <p class="auth-subtitle"><%= ngt("auth.pro_login_title") %></p>

    <form action="<%= web_sign_in_path %>" method="post" novalidate data-controller="form-checks" data-form-checks-scope-value="pro-login" data-action="submit->form-checks#submit turbo:submit-start->form-checks#busy turbo:submit-end->form-checks#idle">
      <% if @error %>
        <div class="alert alert-danger" role="alert"><%= @error %></div>
      <% end %>

      <div class="mb-3">
        <label for="email"><%= ngt("auth.email") %></label>
        <input id="email" name="email" type="email" class="form-control" autocomplete="email" dir="ltr" value="<%= @email %>" data-checks="required email" data-check-message="<%= ngt("common.required") %>">
        <% if @invalid&.include?(:email) %>
          <div class="invalid-feedback d-block" data-check-error="email"><%= ngt("common.required") %></div>
        <% end %>
      </div>

      <div class="mb-3">
        <div class="auth-label-row">
          <label for="password"><%= ngt("auth.password") %></label>
          <a href="/mot-de-passe-oublie" class="auth-forgot-link"><%= ngt("auth.forgot_password") %></a>
        </div>
        <div class="auth-password">
          <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" dir="ltr" data-password data-checks="required" data-check-message="<%= ngt("common.required") %>" data-check-anchor=".auth-password">
          <button type="button" class="auth-eye" data-action="form-checks#togglePassword" data-form-checks-target="eye" data-show-label="<%= ngt("auth.show_password") %>" data-hide-label="<%= ngt("auth.hide_password") %>" aria-label="<%= ngt("auth.show_password") %>" aria-pressed="false">
            <i class="bi bi-eye" aria-hidden="true"></i>
          </button>
        </div>
        <% if @invalid&.include?(:password) %>
          <div class="invalid-feedback d-block" data-check-error="password"><%= ngt("common.required") %></div>
        <% end %>
      </div>

      <button type="submit" class="btn btn-primary w-100 mt-2" data-form-checks-target="submit">
        <%= ngt("auth.sign_in") %>
      </button>
      <%# Last, so the error alert stays the form's first child, as in Angular. %>
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    </form>

    <p class="auth-divider"><%= ngt("auth.new_to_fitora") %></p>
    <a href="/inscription" class="auth-btn-outline"><%= ngt("landing.hero_cta_primary") %></a>
  <% end %>
</app-auth-pro-shell>
