<%# EmptyStateComponent (no styles of its own). The block is its ng-content. %>
<div class="fx-state">
  <div class="fx-state-icon"><i class="bi <%= icon %>"></i></div>
  <p class="fx-state-title"><%= title %></p>
  <% if body.present? %><p class="fx-state-body"><%= body %></p><% end %>
  <%= yield %>
</div>
