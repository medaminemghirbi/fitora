<%# ng: change-password %>
<%# ChangePasswordComponent: your own password while signed in, and signing
    out of every device (change-password). The caller writes the
    <app-change-password> host. %>
<form novalidate class="cp-form" data-controller="change-password"
      data-change-password-url-value="<%= local_assigns[:url] || admin_page_path("settings/password") %>"
      data-change-password-everywhere-url-value="<%= local_assigns[:everywhere_url] || admin_page_path("settings/sign-out-everywhere") %>"
      data-change-password-labels-value="<%= { saving: ngt("common.saving"), submit: ngt("account.change_password"), changed: ngt("account.password_changed"), wrong: ngt("account.current_password_wrong"), error: ngt("common.error_generic"), mismatch: ngt("auth.password_mismatch"), everywhere_title: ngt("account.sign_out_everywhere_title"), everywhere_body: ngt("account.sign_out_everywhere_body"), everywhere: ngt("account.sign_out_everywhere") }.to_json %>"
      data-action="submit->change-password#submit">
  <div class="mb-3">
    <label for="cp-current"><%= ngt("account.current_password") %></label>
    <input id="cp-current" type="password" class="form-control" name="current_password" autocomplete="current-password" dir="ltr" />
  </div>
  <div class="mb-3">
    <label for="cp-new"><%= ngt("auth.new_password") %></label>
    <input id="cp-new" type="password" class="form-control" name="password" autocomplete="new-password" dir="ltr" />
    <small class="form-text"><%= ngt("auth.password_min_length") %></small>
  </div>
  <div class="mb-3">
    <label for="cp-confirm"><%= ngt("auth.confirm_password") %></label>
    <input id="cp-confirm" type="password" class="form-control" name="password_confirmation" autocomplete="new-password" dir="ltr" />
  </div>

  <p class="form-text"><%= ngt("account.change_password_hint") %></p>

  <div class="cp-actions">
    <button type="button" class="btn btn-outline-secondary" data-everywhere data-action="change-password#signOutEverywhere">
      <i class="bi bi-box-arrow-right"></i> <%= ngt("account.sign_out_everywhere") %>
    </button>
    <button type="submit" class="btn btn-primary" data-save>
      <%= ngt("account.change_password") %>
    </button>
  </div>
</form>
