<%# ng: admin-shell %>
<%# ng-host: admin-shell %>
<%# AdminShellComponent (layout/admin-shell): one banner at most, the rail,
    the top bar, the page, the mobile bar. Rendered as a layout around the
    page, which stays the page's own (it is the router's, not the shell's). %>
<% email_unverified = bootstrap.dig(:user, :email_verified) == false && cookies[:fitora_email_banner] != "dismissed" %>
<div class="admin-shell<%= " is-settings-mode" if content_for?(:settings_mode) %>">
  <% if current_impersonator %>
    <div class="impersonation-banner">
      <i class="bi bi-incognito"></i>
      <span><%= ngt("superadmin.impersonating_banner", company: impersonated_company_name) %></span>
      <button type="button" class="impersonation-exit-btn" data-controller="form-submit" data-form-submit-form-value="sign-out-form" data-action="form-submit#submit">
        <i class="bi bi-box-arrow-left"></i> <%= ngt("superadmin.exit_impersonation") %>
      </button>
    </div>
  <% elsif email_unverified %>
    <div class="verify-email-banner" data-controller="email-banner" data-email-banner-url-value="<%= "/admin/#{salle.id}/email_verification" %>" data-email-banner-resent-value="<%= ngt("auth.verify_email_banner_resent") %>">
      <i class="bi bi-envelope-exclamation"></i>
      <span data-email-banner-target="body"><%= ngt("auth.verify_email_banner_body") %></span>
      <button type="button" class="verify-email-banner-link" data-email-banner-target="resend" data-action="email-banner#resend">
        <%= ngt("auth.verify_email_banner_cta") %>
      </button>
      <button type="button" class="verify-email-banner-dismiss" data-action="email-banner#dismiss" aria-label="<%= ngt("common.cancel") %>">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>
  <% end %>

  <div class="admin-shell-body">
    <app-rail><%= render "web/shell/rail" %></app-rail>

    <div class="admin-shell-main">
      <app-navbar><%= render "web/shell/navbar" %></app-navbar>

      <main class="app-content">
        <router-outlet></router-outlet>
        <%= yield %>
      </main>

      <app-mobile-bar><%= render "web/shell/mobile_bar" %></app-mobile-bar>
    </div>
  </div>
</div>
