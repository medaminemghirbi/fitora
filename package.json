{
  "name": "fitora-web",
  "private": true,
  "description": "Assets for Fitora's server-rendered web UI (jsbundling-rails + cssbundling-rails).",
  "scripts": {
    "build": "esbuild app/javascript/application.js --bundle --minify --sourcemap --format=esm --target=es2020 --outdir=app/assets/builds --public-path=/assets",
    "build:css": "node bin/build-css.mjs"
  },
  "dependencies": {
    "@angular/compiler": "17.3.12",
    "@fullcalendar/core": "6.1.22",
    "@fullcalendar/daygrid": "6.1.22",
    "@fullcalendar/interaction": "6.1.22",
    "@fullcalendar/list": "6.1.22",
    "@fullcalendar/timegrid": "6.1.22",
    "@hotwired/stimulus": "3.2.2",
    "@hotwired/turbo-rails": "8.0.23",
    "@rails/actioncable": "8.1.400",
    "@sentry/browser": "11.8.0",
    "bootstrap-icons": "1.13.2",
    "esbuild": "0.28.2",
    "sass": "1.106.1"
  }
}
